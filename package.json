{
  "name": "nextjs-multivendor-marketplace",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "devt": "next dev --turbopack -p 3001",
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:seed": "node --env-file=.env prisma/seed.mjs",
    "db:hash-passwords": "node --env-file=.env scripts/hash-existing-passwords.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit -p .",
    "commitlint": "commitlint --from origin/main --to HEAD --verbose",
    "prepare": "husky || true",
    "precommit": "lint-staged"
  },
  "dependencies": {
    "@prisma/client": "6.7.0",
    "@prisma/extension-accelerate": "^1.3.0",
    "jose": "^6.0.11",
    "next": "15.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "winston": "^3.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-typescript": "^7.27.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/eslintrc": "^3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/jest-json-schema": "^6.1.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-jest": "^29.7.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-json-schema": "^6.1.0",
    "lint-staged": "^17.6.1",
    "next-test-api-route-handler": "^4.0.16",
    "prisma": "^6.7.0",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
