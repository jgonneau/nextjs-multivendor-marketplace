{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    // The frontend is a separate Next.js app with its own tsconfig.
    "frontend",
    // Scratch examples, not real tests (jest doesn't match *.example.tsx
    // either) — some reference packages (node-mocks-http) that were never
    // installed, which would otherwise fail `next build`'s type-check.
    "__test__/**/*.example.tsx"
  ]
}
