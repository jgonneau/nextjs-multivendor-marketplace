# Copy to .env.test:  cp .env.test.example .env.test
# Loaded by next/jest when NODE_ENV=test (Jest sets it), on top of .env;
# values here win. The tests refuse to run unless the database name ends in
# _test, and they rebuild it from the migrations on every run.

# Same PostgreSQL server as development, separate database (created automatically).
DATABASE_URL="postgresql://testuser:testpassword@localhost:5434/nextjs_multivendor_marketplace_test?schema=public"

# Test-only secrets, so the tests don't depend on your real .env. Any value works.
AUTH_SECRET="test-only-auth-secret-not-for-production"
LOG_TOKEN_SECRET="test-only-log-secret"
