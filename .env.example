# Copy to .env and fill in the secrets:  cp .env.example .env
# Used by `pnpm dev`, the Prisma CLI, the seed script and the Docker `api` service.

# PostgreSQL, as reached from your machine (the Docker `db` service publishes
# port 5434). Inside Docker, docker-compose.yml overrides this with db:5432.
DATABASE_URL="postgresql://testuser:testpassword@localhost:5434/postgres?schema=public"

# Signs and verifies the JWTs. Generate with: openssl rand -base64 48
AUTH_SECRET=""

# Shared secret for POST /api/logs (sent as "Bearer: TOKEN <secret>").
# Generate with: openssl rand -base64 48
LOG_TOKEN_SECRET=""

# Optional: winston log level (error, warn, info, http, verbose, debug). Default: debug.
# LOG_LEVEL=info

# Optional, Docker only: database credentials for the `db` service. Compose reads
# them from this file; if you change them, update DATABASE_URL above to match.
# POSTGRES_USER=testuser
# POSTGRES_PASSWORD=testpassword
# POSTGRES_DB=postgres
